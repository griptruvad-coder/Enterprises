# Copy to .env for local runs (never commit .env). On Render, set these in the dashboard.
NODE_ENV=development
PORT=3000

# Where the SQLite file lives. On Render: /var/data/sbs.db (persistent disk mount)
DB_PATH=./data/sbs.db

# Exact public URL(s) of the site, comma-separated. Requests from any other origin are rejected.
APP_ORIGIN=http://localhost:3000

# These emails become admins when they sign up or sign in. Comma-separated.
ADMIN_EMAILS=founder@prakharenterprises.in

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > add https://YOUR-SITE/api/webhooks/razorpay, events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=

# Optional
PROMO_CODES=SBS10:10
TIER_PRICES=delegate:1499,founder:2999,vip:9999
